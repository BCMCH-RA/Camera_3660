<script>
const $ = id => document.getElementById(id);
let live = true;
let imageURL = null;
let commandPending = false;

const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));

async function api(url, options = {}) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 10000);
  try {
    const response = await fetch(url, {
      ...options, cache: "no-store", signal: controller.signal
    });
    if (!response.ok) throw new Error(await response.text());
    // Consume body before clearing the timeout.
    return await response.blob();
  } finally {
    clearTimeout(timer);
  }
}

async function liveLoop() {
  while (true) {
    if (live && !document.hidden) {
      try {
        const blob = await api("/frame");
        const nextURL = URL.createObjectURL(blob);
        const oldURL = imageURL;
        $("camera").src = nextURL;
        imageURL = nextURL;
        try { await $("camera").decode(); } catch (_) {}
        if (oldURL) URL.revokeObjectURL(oldURL);
        $("cameraStatus").textContent = live ? "Live" : "Paused";
      } catch (error) {
        $("cameraStatus").textContent = "Camera: " + error.message;
        await sleep(800);
      }
    }
    await sleep(125); // Only one frame request is in flight.
  }
}

$("live").onclick = () => {
  live = !live;
  $("live").textContent = live ? "Pause live view" : "Resume live view";
  $("cameraStatus").textContent = live ? "Connecting..." : "Paused";
};

$("photo").onclick = async () => {
  $("photo").disabled = true;
  try {
    const blob = await api("/photo.jpg");
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = "xiao-" + Date.now() + ".jpg";
    document.body.appendChild(link);
    link.click();
    link.remove();
    setTimeout(() => URL.revokeObjectURL(url), 30000);
  } catch (error) {
    $("cameraStatus").textContent = error.message;
  } finally {
    $("photo").disabled = false;
  }
};

$("record").onclick = async () => {
  commandPending = true;
  $("record").disabled = true;
  $("audioDownload").hidden = true;
  try {
    await api("/record?seconds=" + $("duration").value, {method: "POST"});
    $("audioStatus").textContent = "Recording...";
  } catch (error) {
    $("audioStatus").textContent = error.message;
  } finally {
    commandPending = false;
  }
};

async function statusLoop() {
  while (true) {
    try {
      const blob = await api("/status");
      const state = JSON.parse(await blob.text());

      if (!commandPending) {
        $("record").disabled = state.busy;
        $("duration").disabled = state.busy;
        $("audioDownload").hidden = state.busy || !state.ready;

        $("audioStatus").textContent = state.busy
          ? "Recording: " + state.seconds.toFixed(1) +
            " / " + state.target + " seconds"
          : state.error
            ? state.error
            : state.ready
              ? "Recording ready. Download before recording again."
              : "Ready";
      }
    } catch (_) {
      $("record").disabled = true;
      $("audioStatus").textContent = "Connection lost. Reconnect to XIAO-Sense.";
    }
    await sleep(500);
  }
}

liveLoop();
statusLoop();
</script>
</body>
</html>
