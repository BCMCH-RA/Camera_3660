// ---------- Settings ----------

const char *AP_SSID = "XIAO-Sense";
const char *AP_PASSWORD = "sense12345";  // At least 8 characters

constexpr uint32_t SAMPLE_RATE = 16000;
constexpr uint32_t AUDIO_BYTES_PER_SECOND = SAMPLE_RATE * 2;
constexpr uint32_t MAX_RECORD_SECONDS = 30;
constexpr uint32_t FRAME_INTERVAL_MS = 125;  // Target <= 8 FPS

AsyncWebServer server(80);
I2SClass microphone;

SemaphoreHandle_t dataMutex;
QueueHandle_t recordingQueue;

// Immutable after publication to the web server.
// Each HTTP response holds a shared_ptr so its bytes remain valid
// until transmission finishes or the client disconnects.
struct Blob {
  uint8_t *data;
  size_t size;

  explicit Blob(size_t n) : data(nullptr), size(n) {
    data = static_cast<uint8_t *>(
      heap_caps_malloc(n, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT)
    );
  }

  ~Blob() {
    free(data);
  }

  Blob(const Blob &) = delete;
  Blob &operator=(const Blob &) = delete;
};

using BlobPtr = std::shared_ptr<Blob>;

BlobPtr latestFrame;
BlobPtr latestRecording;

uint32_t frameTime = 0;
bool recordingBusy = false;
uint32_t recordedBytes = 0;
uint32_t requestedSeconds = 0;
const char *recordingError = "";

// Explicit prototype keeps Arduino's prototype generator happy.
void sendBlob(
  AsyncWebServerRequest *request,
  BlobPtr blob,
  const char *mime,
  const char *filename
);

// ---------- Browser page ----------

const char PAGE[] PROGMEM = R"HTML(
<!doctype html>
<html lang="en">
